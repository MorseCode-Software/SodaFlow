<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net472;net60;netstandard2.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>SodaFlow.Collections.Core</PackageId>
        <MinVerTagPrefix>sodaflow-collections-core-</MinVerTagPrefix>
        <Product>SodaFlow Collections Core for .NET</Product>
        <Title>SodaFlow Collections Core for .NET</Title>
        <Description>SodaFlow Reactive Collections library for .NET core library.</Description>
        <AssemblyName>SodaFlow.Core.Collections</AssemblyName>
        <RootNamespace>SodaFlow.Collections</RootNamespace>
        <EnableDefaultItems>false</EnableDefaultItems>
        <Nullable>enable</Nullable>
        <LangVersion>10</LangVersion>
        <!--
            As in SodaFlow.Core.Async: the types a consumer actually holds are declared here rather
            than in the language wrappers, so their documentation has to be emitted here too.
            GenerateDocumentationFile rather than an explicit path, because this multi-targets.
        -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.ValueTuple" Version="4.6.2"/>
        <!--
            The hash array mapped trie behind ImmutableStateMap, and the sorted set behind
            SortedKeys. In the box on net6.0 and a real package on net472 and netstandard2.0, which
            is why this is unconditional: NuGet resolves the in-box implementation where there is
            one.
        -->
        <PackageReference Include="System.Collections.Immutable" Version="8.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="AssemblyInfo.cs"/>
        <Compile Include="CollectionChange.cs"/>
        <Compile Include="CollectionEdit.cs"/>
        <Compile Include="CollectionInternals.cs"/>
        <Compile Include="CollectionSnapshot.cs"/>
        <Compile Include="CollectionViewChange.cs"/>
        <Compile Include="CollectionViewStage.cs"/>
        <Compile Include="CollectionViewUtility.cs"/>
        <Compile Include="Entry.cs"/>
        <Compile Include="FrpCollection.cs"/>
        <Compile Include="IFrpCollection.cs"/>
        <Compile Include="IStateMap.cs"/>
        <Compile Include="OrderedKeys.cs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\SodaFlow.Core\SodaFlow.Core.csproj"/>
        <!--
            SodaFlow.Functional, which neither SodaFlow.Async.Core nor
            SodaFlow.Bindable.ObjectModel.Core needs. Optionality is Maybe<T> throughout this API
            rather than null - StateCell is a Cell<Maybe<TState>>, IndexOf answers Maybe<int>,
            CollectionChange.ChangeFor nests two of them to say "moved" and "still present"
            separately - so the type is in the public surface and cannot be an implementation
            detail of a wrapper.

            The consequence worth knowing about: SodaFlow.FSharp.Collections therefore acquires
            SodaFlow.Functional transitively, where SodaFlow.FSharp deliberately does not. F# has
            option, and this API answers with Maybe. Converting at the F# boundary would mean a
            graph node per cell to gain nothing the two types do not both say.
        -->
        <ProjectReference Include="..\..\CSharp\SodaFlow.Functional\SodaFlow.Functional.csproj"/>
    </ItemGroup>

</Project>
