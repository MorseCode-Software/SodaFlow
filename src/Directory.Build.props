<Project>

    <!--
        Package metadata shared by every packable project here. Anything that identifies an
        individual package — PackageId, Title, Product, Description, AssemblyName, RootNamespace —
        stays in that project's own file.
    -->
    <PropertyGroup>
        <Authors>MorseCode Software LLC</Authors>
        <Company>MorseCode Software LLC</Company>
        <PackageProjectUrl>https://github.com/MorseCode-Software/SodaFlow</PackageProjectUrl>
        <IncludeSource>True</IncludeSource>
        <IncludeSymbols>True</IncludeSymbols>
    </PropertyGroup>

    <!--
        PackageLicenseExpression rather than the PackageLicenseUrl these projects used previously:
        licenseUrl is deprecated by NuGet and warns as NU5125, and an expression additionally gives
        nuget.org a real license badge and lets dependency auditing tools read the license without
        fetching a URL.

        BSD-3-Clause, not the MIT that the old licenseUrl pointed at. The repository's LICENSE is a
        three-clause BSD license — it carries both the binary-redistribution clause and the
        non-endorsement clause, neither of which exists in MIT — so the previous declaration was
        simply wrong. There is no .NET-specific license file, so root LICENSE governs this code.

        LICENSE's "except for portions of this code where a different license is given" preamble
        still applies: JetBrainsAnnotations.cs in SodaFlow and SodaFlow.Functional carries JetBrains'
        own MIT notice. An expression describes the license of the package's own code, which is what
        this is; the third-party notice travels in the source file that bears it.
    -->
    <PropertyGroup>
        <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    </PropertyGroup>

    <!--
        Versions come from git tags via MinVer, so no project hardcodes Version, PackageVersion,
        AssemblyVersion, FileVersion or InformationalVersion any more.

        Each packable project sets its own MinVerTagPrefix, and that is what lets these packages
        release on independent schedules: a project's stable version only moves when a tag carrying
        its own prefix is pushed. Tagging sodaflow-async-1.1.0 releases the C# async wrapper at 1.1.0
        and leaves every other package where its own last tag put it. This follows the per-component
        tagging inherited from the Sodium repository this code came from.

        A commit with no matching tag builds as a prerelease of the next patch, e.g.
        1.0.1-alpha.0.7, where 7 counts commits since the tag. CI can therefore build and pack every
        commit while only tagged builds ever produce a version worth publishing.

        To collapse several packages onto one release train, give them the same prefix; they then
        version and release together off a single tag.

        MinVerIgnoreHeight is on for exactly this reason: without it, height counts every commit in
        the whole repository, not just commits touching a given project, so any package's version
        keeps drifting to a new prerelease (1.0.1-alpha.0.1, .2, .3...) as soon as anything else in
        the repo moves — even changes nowhere near that project. That also poisons every dependent's
        nuspec: a downstream package's dependency entry is read from the referenced project's own
        resolved version at pack time, so an unrelated commit anywhere could turn a stable release's
        dependency floor into a moving prerelease target and trip NuGet's NU5104 warning. With this
        set, a project with no new tag since its last release keeps reporting exactly that tagged
        version, no matter how much unrelated activity happens elsewhere — confirmed empirically:
        packing a project 5 commits past its tag, with this on, still produces the exact tagged
        version, not a next-patch prerelease. The cost is the one this flag is named for: a commit
        that actually changes a project, but isn't followed by a new tag, is indistinguishable from
        one that doesn't touch it at all — both keep reporting the last tag's version. That's an
        accepted tradeoff here, not an oversight: tag on release, and don't rely on the prerelease
        version to reflect "there are unreleased changes."

        The UsingMicrosoftNETSdk guards below are vestigial. They were added when four of the
        C# test projects were still non-SDK and using packages.config, which cannot consume a
        PackageReference; "Update to SDK style projects" converted the last of those later the
        same day, so the condition is now always true.
    -->
    <ItemGroup Condition="'$(UsingMicrosoftNETSdk)' == 'true'">
        <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all"/>
    </ItemGroup>

    <PropertyGroup Condition="'$(UsingMicrosoftNETSdk)' == 'true'">
        <MinVerIgnoreHeight>true</MinVerIgnoreHeight>
    </PropertyGroup>

    <!--
        JetBrains.Annotations for every project here, rather than the same line in each of them. The
        attributes are read at build time, by the compiler and by ReSharper, and say nothing a
        consumer needs at runtime, so PrivateAssets keeps the reference out of the packages.

        SodaFlow and SodaFlow.Functional additionally compile a vendored copy of the annotations, so
        that the attributes they apply to their own public API travel with the source rather than
        obliging a consumer to acquire the package. That copy and this reference coexist, as they
        did when every project declared this itself.
    -->
    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all"/>
    </ItemGroup>

    <!--
        FSharp.Core for every F# project here, shipping and test alike, rather than the three that
        used to name it. The F# SDK references it implicitly and this property is what chooses the
        version, so it reaches the test projects too - which is the point. With only the shipping
        projects pinned, they compiled against one version while the tests supplied whatever the SDK
        implied, and MSB3277 reported the conflict.

        This is a dependency floor for consumers of the three F# packages, not just a build detail:
        it is written into their nuspecs.
    -->
    <PropertyGroup>
        <FSharpCoreImplicitPackageVersion>11.0.100</FSharpCoreImplicitPackageVersion>
    </PropertyGroup>

    <!--
        PackageReleaseNotes read from a file rather than set as a literal in each project. Seven
        packages would otherwise mean seven csproj edits per release, which is seven chances to
        leave one of them describing the release before last.

        The per-project file wins where it exists, and the repository-wide one covers the rest.
        Both are needed: this release moved six packages to 2.0.0 for one reason and
        SodaFlow.Functional to 1.0.1 for a different one, and giving Functional the breaking-change
        notes would have been simply untrue. Where nothing is found, the releases page is a better
        answer than an empty field.

        Resolved in a target rather than a property group so the files are read only when packing,
        and so a project that sets PackageReleaseNotes itself still wins.
    -->
    <!--
        Dependencies between these packages are emitted with an upper bound, so that NuGet refuses
        an incompatible pairing rather than a release note asking people not to create one.

        Pack writes a ProjectReference dependency as a bare version, which NuGet reads as a
        minimum with no ceiling: SodaFlow 2.0.1 declared SodaFlow.Core >= 2.1.1, and would happily
        resolve against SodaFlow.Core 3.0.0 - the one pairing that throws MissingMethodException,
        because the core renamed internals these wrappers call. The constraint was real and only
        prose expressed it, which is no constraint at all.

        The ceiling is the next major of the dependency. That is exactly the promise a major
        version carries here: SodaFlow.Core treats its internal surface as API precisely because
        eight packages compile against it, so a wrapper built against 3.x works with any later 3.x
        and is not promised anything about 4.0.0.

        This works by rewriting the metadata NuGet has just collected. _GetProjectReferenceVersions
        asks each referenced project for its PackageVersion and stores it as ProjectVersion
        metadata; GenerateNuspec runs that target first and then reads the result, so a target
        placed between the two can widen the value into a range without overriding anything NuGet
        owns. The major is taken with a regular expression rather than System.Version.Parse, which
        cannot read the prerelease versions MinVer produces for untagged commits.
    -->
    <Target Name="AddUpperBoundToProjectReferenceVersions"
            AfterTargets="_GetProjectReferenceVersions"
            Condition="'$(NuspecFile)' == ''">
        <ItemGroup>
            <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)">
                <ProjectVersion>[%(ProjectVersion), $([MSBuild]::Add($([System.Text.RegularExpressions.Regex]::Match(%(ProjectVersion), `^[0-9]+`).Value), 1)).0.0)</ProjectVersion>
            </_ProjectReferencesWithVersions>
        </ItemGroup>
    </Target>

    <Target Name="SetPackageReleaseNotesFromFile" BeforeTargets="GenerateNuspec">
        <PropertyGroup>
            <_ProjectReleaseNotes>$(MSBuildProjectDirectory)\PackageReleaseNotes.md</_ProjectReleaseNotes>
            <_SharedReleaseNotes>$(MSBuildThisFileDirectory)..\PackageReleaseNotes.md</_SharedReleaseNotes>

            <PackageReleaseNotes Condition="'$(PackageReleaseNotes)' == '' And Exists('$(_ProjectReleaseNotes)')">$([System.IO.File]::ReadAllText('$(_ProjectReleaseNotes)'))</PackageReleaseNotes>
            <PackageReleaseNotes Condition="'$(PackageReleaseNotes)' == '' And Exists('$(_SharedReleaseNotes)')">$([System.IO.File]::ReadAllText('$(_SharedReleaseNotes)'))</PackageReleaseNotes>
            <PackageReleaseNotes Condition="'$(PackageReleaseNotes)' == ''">https://github.com/MorseCode-Software/SodaFlow/releases</PackageReleaseNotes>
        </PropertyGroup>
    </Target>

</Project>
