<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!--
            The analyzer has a table that says which of two objects a method of the platform gives
            a call to. The platform does not document that, so these tests run each row. They run
            on each target framework of the test projects, because a row is correct only while
            each runtime agrees. The tests of the analyzer itself run on net10.0 only.
        -->
        <TargetFrameworks>net10.0;net472</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <!-- TUnit's transitive dependencies do not claim net472; their netstandard2.0 assets work. -->
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
        <!-- The usings are listed per file here, as everywhere else in this repository. -->
        <TUnitImplicitUsings>disable</TUnitImplicitUsings>
        <TUnitAssertionsImplicitUsings>disable</TUnitAssertionsImplicitUsings>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- Microsoft.Testing.Platform builds a native apphost for net472, which needs an explicit RID. -->
    <PropertyGroup Condition=" '$(TargetFramework)' == 'net472' ">
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    </PropertyGroup>

    <PropertyGroup>
        <AssemblyName>SodaFlow.Analyzers.Platform.Tests</AssemblyName>
        <RootNamespace>SodaFlow.Analyzers.Platform.Tests</RootNamespace>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" Version="1.66.27"/>
        <PackageReference Include="System.ValueTuple" Version="4.6.2"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\TestPolyfills.cs" Link="TestPolyfills.cs"/>
        <!--
            The table itself, as source. The analyzer is a netstandard2.0 assembly that needs the
            compiler, and this project must not. The file uses no type of the compiler.
        -->
        <Compile Include="..\SodaFlow.Analyzers\PlatformReceivers.cs" Link="PlatformReceivers.cs"/>
        <Compile Include="PlatformReceiversTests.cs"/>
    </ItemGroup>

</Project>
