<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net472;net60;netstandard2.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>SodaFlow.Bindable.ObjectModel</PackageId>
        <MinVerTagPrefix>sodaflow-bindable-objectmodel-</MinVerTagPrefix>
        <Product>SodaFlow Bindable Object Model for C#</Product>
        <Title>SodaFlow Bindable Object Model for C#</Title>
        <Description>SodaFlow Bindable Object Model library for C#.</Description>
        <AssemblyName>SodaFlow.Bindable.ObjectModel</AssemblyName>
        <RootNamespace>SodaFlow.Bindable.ObjectModel</RootNamespace>
        <EnableDefaultItems>false</EnableDefaultItems>
        <Nullable>enable</Nullable>
        <LangVersion>10</LangVersion>
        <!--
            GenerateDocumentationFile rather than an explicit DocumentationFile path: this project
            multi-targets, and a single hard-coded path would make all three target frameworks write
            over one another's XML.
        -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!--
            Not packed until this package has a version to be packed at. MinVer versions a project
            with no tag of its own prefix as 0.0.0-alpha.0, and appveyor.yml pushes every non-symbols
            nupkg a tag build produces - so without this, the next tag for any package at all would
            publish a 0.0.0-alpha.0 of this one. nuget.org unlists a version but never deletes it.

            The implementation is here and tested; only the tag is missing. Push
            sodaflow-bindable-objectmodel-x.y.z and remove this line in the same change.
        -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageReference Include="System.ValueTuple" Version="4.4.0"/>
    </ItemGroup>

    <ItemGroup>
      <Compile Include="BindableAction.cs" />
      <Compile Include="BindableExtensionMethods.cs" />
      <Compile Include="BindableFactory.cs" />
      <Compile Include="Interfaces.cs" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\SodaFlow.Core.Bindable.ObjectModel\SodaFlow.Core.Bindable.ObjectModel.csproj" />
      <!--
          SodaFlow itself, so installing this package brings the C# API it extends. A bindable is
          built from a Cell or a sink, and only SodaFlow's operations produce those, so a consumer
          needs both; declaring it here means they get both from one install rather than
          discovering the second the first time they try to build a graph.
      -->
      <ProjectReference Include="..\..\..\..\CSharp\SodaFlow\SodaFlow.csproj" />
      <ProjectReference Include="..\..\..\..\CSharp\SodaFlow.Functional\SodaFlow.Functional.csproj" />
    </ItemGroup>

</Project>
