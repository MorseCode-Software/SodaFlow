<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>SodaFlow.FSharp.Bindable.ObjectModel</AssemblyName>
    <RootNamespace>SodaFlow.Bindable.ObjectModel</RootNamespace>
    <TargetFrameworks>net472;net60;netstandard2.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SodaFlow.FSharp.Bindable.ObjectModel</PackageId>
    <MinVerTagPrefix>sodaflow-fsharp-bindable-objectmodel-</MinVerTagPrefix>
    <Product>SodaFlow Bindable Object Model for F#</Product>
    <Title>SodaFlow Bindable Object Model for F#</Title>
    <Description>SodaFlow Bindable Object Model library for F#.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <!--
        GenerateDocumentationFile rather than an explicit DocumentationFile path: this project
        multi-targets, and a single hard-coded path would make all three target frameworks write
        over one another's XML.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
        F# has no equivalent of CS1591, so nothing reports a member that carries no documentation at
        all. FS3390 is the next best thing and is off by default: it checks the comments that do
        exist, catching a <param> naming an argument that does not exist and a documented function
        with an argument left undocumented.
    -->
    <OtherFlags>$(OtherFlags) --warnon:3390</OtherFlags>

    <!--
        Not packed until there is something to ship. MinVer versions a project with no tag of
        its own prefix as 0.0.0-alpha.0, and appveyor.yml pushes every nupkg produced by a tag
        build, so leaving this out would publish an empty package on the next release of
        anything at all. Remove this line when the implementation lands, and push the first
        sodaflow-fsharp-bindable-objectmodel-x.y.z tag.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="4.5.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Bindable.fs" />
    <Compile Include="BindableFactory.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SodaFlow.Core.Bindable.ObjectModel\SodaFlow.Core.Bindable.ObjectModel.csproj" />
  </ItemGroup>

</Project>
