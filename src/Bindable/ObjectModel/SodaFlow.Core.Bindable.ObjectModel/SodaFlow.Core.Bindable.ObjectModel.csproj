<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net472;net60;netstandard2.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>SodaFlow.Bindable.ObjectModel.Core</PackageId>
        <MinVerTagPrefix>sodaflow-bindable-objectmodel-core-</MinVerTagPrefix>
        <Product>SodaFlow Bindable Object Model Core for .NET</Product>
        <Title>SodaFlow Bindable Object Model Core for .NET</Title>
        <Description>SodaFlow Bindable Object Model library for .NET core library.</Description>
        <AssemblyName>SodaFlow.Core.Bindable.ObjectModel</AssemblyName>
        <RootNamespace>SodaFlow.Bindable.ObjectModel</RootNamespace>
        <EnableDefaultItems>false</EnableDefaultItems>
        <Nullable>enable</Nullable>
        <LangVersion>10</LangVersion>
        <!--
            As in SodaFlow.Core.Async: the types a consumer actually holds are declared here rather
            than in the language wrappers, so their documentation has to be emitted here too.
            GenerateDocumentationFile rather than an explicit path, because this multi-targets.
        -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageReference Include="System.ValueTuple" Version="4.4.0"/>
    </ItemGroup>

    <ItemGroup>
      <Compile Include="AssemblyInfo.cs" />
      <Compile Include="BindableExtensionMethods.cs" />
      <Compile Include="BindableAction.cs" />
      <Compile Include="BindableValueBase.cs" />
      <Compile Include="BindingScheduler.cs" />
      <Compile Include="Interfaces.cs" />
      <Compile Include="OneWayBindableValue.cs" />
      <Compile Include="OneWayToSourceBindableValue.cs" />
      <Compile Include="TwoWayBindableValue.cs" />
      <Compile Include="ValueBox.cs" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\SodaFlow.Core\SodaFlow.Core.csproj" />
    </ItemGroup>

</Project>
