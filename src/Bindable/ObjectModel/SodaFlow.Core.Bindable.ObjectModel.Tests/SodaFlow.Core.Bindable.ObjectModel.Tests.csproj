<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!--
            Single-targeted at net472, unlike the sibling source projects: dotnet test needs one
            concrete assembly to run, and net472 is what matches the rest of this solution.
        -->
        <TargetFrameworks>net10.0;net472</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <!-- TUnit's transitive dependencies do not claim net472; their netstandard2.0 assets work. -->
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
        <!-- The usings are listed per file here, as everywhere else in this repository. -->
        <TUnitImplicitUsings>disable</TUnitImplicitUsings>
        <TUnitAssertionsImplicitUsings>disable</TUnitAssertionsImplicitUsings>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- Microsoft.Testing.Platform builds a native apphost for net472, which needs an explicit RID. -->
    <PropertyGroup Condition=" '$(TargetFramework)' == 'net472' ">
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    </PropertyGroup>

    <PropertyGroup>
        <AssemblyName>SodaFlow.Core.Bindable.ObjectModel.Tests</AssemblyName>
        <RootNamespace>SodaFlow.Bindable.ObjectModel.Tests</RootNamespace>
        <EnableDefaultItems>false</EnableDefaultItems>
        <Nullable>enable</Nullable>
        <!-- Never packed. Microsoft.NET.Test.Sdk implies this; stated anyway, as the siblings do. -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all"/>
        <PackageReference Include="TUnit" Version="1.66.8"/>
        <PackageReference Include="System.ValueTuple" Version="4.6.2"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\..\TestPolyfills.cs" Link="TestPolyfills.cs"/>
        <Compile Include="..\..\..\TestParallelism.cs" Link="TestParallelism.cs"/>
        <Compile Include="BindableActionTests.cs"/>
        <Compile Include="TestUtility.cs"/>
        <Compile Include="BindableValueConcurrencyTests.cs"/>
        <Compile Include="BindableValueTests.cs"/>
        <Compile Include="BindingSchedulerTests.cs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\SodaFlow.Core\SodaFlow.Core.csproj"/>
        <ProjectReference Include="..\..\..\CSharp\SodaFlow\SodaFlow.csproj"/>
        <ProjectReference Include="..\SodaFlow.Core.Bindable.ObjectModel\SodaFlow.Core.Bindable.ObjectModel.csproj"/>
    </ItemGroup>

</Project>
