<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net472;net60;netstandard2.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>SodaFlow.Async</PackageId>
        <MinVerTagPrefix>sodaflow-async-</MinVerTagPrefix>
        <Product>SodaFlow Async for C#</Product>
        <Title>SodaFlow Async for C#</Title>
        <Description>SodaFlow Async Extensions library for C#.</Description>
        <AssemblyName>SodaFlow.Async</AssemblyName>
        <RootNamespace>SodaFlow.Async</RootNamespace>
        <EnableDefaultItems>false</EnableDefaultItems>
        <Nullable>enable</Nullable>
        <LangVersion>10</LangVersion>
        <!--
            GenerateDocumentationFile rather than an explicit DocumentationFile path: this project
            multi-targets, and a single hard-coded path would make all three target frameworks write over
            one another's XML. This emits one file per target framework, next to its own assembly, which
            is also where NuGet pack expects to find it when populating each lib folder.
        -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all"/>
        <PackageReference Include="System.ValueTuple" Version="4.4.0"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="AsyncConcurrencyStrategy.cs"/>
        <Compile Include="MapAsyncExtensions.cs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\SodaFlow.Core.Async\SodaFlow.Core.Async.csproj"/>
        <!--
            SodaFlow itself, so installing this package brings the C# API it extends. MapAsync
            operates on a Stream<T> that only SodaFlow's operations can produce or consume usefully,
            so a consumer needs both; declaring it here means they get both from one install rather
            than discovering the second the first time they try to build a graph.
        -->
        <ProjectReference Include="..\..\..\CSharp\SodaFlow\SodaFlow.csproj"/>
        <ProjectReference Include="..\..\..\CSharp\SodaFlow.Functional\SodaFlow.Functional.csproj"/>
    </ItemGroup>

</Project>
