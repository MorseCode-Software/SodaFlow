<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!--
            Single-targeted at net472, unlike the sibling source projects' net472;net60;netstandard2.0:
            dotnet test needs one concrete assembly to run, and net472 is what matches the rest of
            this solution's own target — a netstandard2.0 build wouldn't be runnable at all, and
            nothing here exercises a net60 one.
        -->
        <TargetFrameworks>net10.0;net472</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <!-- TUnit's transitive dependencies do not claim net472; their netstandard2.0 assets work. -->
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
        <!-- The usings are listed per file here, as everywhere else in this repository. -->
        <TUnitImplicitUsings>disable</TUnitImplicitUsings>
        <TUnitAssertionsImplicitUsings>disable</TUnitAssertionsImplicitUsings>
        <!-- This pinned C# 10 until TUnit arrived. Its source generator refuses anything below
             12 (TUNIT_LANG_001), and at exactly 12 its own IsEmpty extension resolves to the
             one for System.IO.Stream, so latest it is - as in the other test projects. -->
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- Microsoft.Testing.Platform builds a native apphost for net472, which needs an explicit RID. -->
    <PropertyGroup Condition=" '$(TargetFramework)' == 'net472' ">
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    </PropertyGroup>

    <PropertyGroup>
        <AssemblyName>SodaFlow.Core.Async.Tests</AssemblyName>
        <RootNamespace>SodaFlow.Async.Tests</RootNamespace>
        <EnableDefaultItems>false</EnableDefaultItems>
        <Nullable>enable</Nullable>
        <!-- Never packed — appveyor.yml's after_test step names the seven packable projects explicitly. -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" Version="1.66.10"/>
        <PackageReference Include="System.ValueTuple" Version="4.6.2"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\TestPolyfills.cs" Link="TestPolyfills.cs"/>
        <Compile Include="..\..\TestParallelism.cs" Link="TestParallelism.cs"/>
        <Compile Include="AsyncConcurrencyStrategyFactoryTests.cs"/>
        <Compile Include="MapAsyncImplTests.cs"/>
        <Compile Include="TestUtil.cs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\SodaFlow.Core\SodaFlow.Core.csproj"/>
        <ProjectReference Include="..\..\CSharp\SodaFlow\SodaFlow.csproj"/>
        <ProjectReference Include="..\SodaFlow.Core.Async\SodaFlow.Core.Async.csproj"/>
    </ItemGroup>

</Project>
