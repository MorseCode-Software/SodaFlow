<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net472</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <!-- TUnit's transitive dependencies do not claim net472; their netstandard2.0 assets work. -->
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
        <!-- The usings are listed per file here, as everywhere else in this repository. -->
        <TUnitImplicitUsings>disable</TUnitImplicitUsings>
        <TUnitAssertionsImplicitUsings>disable</TUnitAssertionsImplicitUsings>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- Microsoft.Testing.Platform builds a native apphost for net472, which needs an explicit RID. -->
    <PropertyGroup Condition=" '$(TargetFramework)' == 'net472' ">
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    </PropertyGroup>

    <PropertyGroup>
        <AssemblyName>SodaFlow.Tests</AssemblyName>
        <RootNamespace>SodaFlow.Tests</RootNamespace>
        <EnableDefaultItems>false</EnableDefaultItems>
        <IsPackable>false</IsPackable>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" Version="1.66.10"/>
        <PackageReference Include="System.ValueTuple" Version="4.6.2"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\TestPolyfills.cs" Link="TestPolyfills.cs"/>
        <Compile Include="..\..\TestParallelism.cs" Link="TestParallelism.cs"/>
        <Compile Include="BehaviorTests.cs"/>
        <Compile Include="CellTests.cs"/>
        <Compile Include="CommonTests.cs"/>
        <Compile Include="DenotationalSemanticsTests.cs"/>
        <Compile Include="EitherTests.cs"/>
        <Compile Include="EnumerableExtensionMethodsTests.cs"/>
        <Compile Include="ForwardReferenceTests.cs"/>
        <Compile Include="IssueTests.cs"/>
        <Compile Include="LoopTests.cs"/>
        <Compile Include="MaybeAsyncExtensionMethodsTests.cs"/>
        <Compile Include="MaybeExtensionMethodsTests.cs"/>
        <Compile Include="MaybeMonadTests.cs"/>
        <Compile Include="MaybeTests.cs"/>
        <Compile Include="PerformanceTests.cs"/>
        <Compile Include="ReadOnlyDictionaryExtensionMethodsTests.cs"/>
        <Compile Include="StreamTests.cs"/>
        <Compile Include="StringExtensionMethodsTests.cs"/>
        <Compile Include="TimerTests.cs"/>
        <Compile Include="TransactionTests.cs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\SodaFlow.Core\SodaFlow.Core.csproj"/>
        <ProjectReference Include="..\SodaFlow\SodaFlow.csproj"/>
        <ProjectReference Include="..\SodaFlow.Functional\SodaFlow.Functional.csproj"/>
    </ItemGroup>

</Project>
