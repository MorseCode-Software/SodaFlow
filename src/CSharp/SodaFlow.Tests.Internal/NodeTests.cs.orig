    [Test]
    public void TestDependency()
    {
        StreamSink<int> streamSink = Stream.CreateSink<int>();
        Stream<int> stream = streamSink.Map(static v => v * 2);

        Assert.That(actual: streamSink.Node.Rank, expression: Is.LessThan(stream.Node.Rank));
    }

    [Test]
