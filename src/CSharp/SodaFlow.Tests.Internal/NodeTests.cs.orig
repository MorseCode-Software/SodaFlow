        CellSink<int> cellSink = Cell.CreateSink(0);
        StreamSink<Unit> streamSink = Stream.CreateSink<Unit>();

        Cell<int> cell =
            cellSink.Map(n =>
                {
                    Cell<int> c = Cell.Constant(0);

