<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- Both, because the libraries support both and some of what is measured here differs
             sharply between them. Benchmarks declare the runtimes they run on as jobs, so a
             single run reports each; this pair is what those jobs are built from.

             Not net60, for the reason it never was: a project reference resolves to the
             libraries' net60 assets whatever the modern target here is, so the assembly measured
             is the one a consumer gets either way, while the runtime running it is one still in
             support. Targeting net60 here costs six warnings - its own end-of-life notice, and
             BenchmarkDotNet's dependencies declining to claim support for it.

             net10.0 rather than the net8.0 this was, and the reason is entirely about the build
             rather than the measurement: net10.0 is what global.json pins and what every test
             project already targets, so it is the one modern framework CI has on hand. Asking for
             net8.0 made this the only project in the repository that needed a second SDK
             installed, which cost about 26 seconds on each of two jobs for one benchmark
             executable nobody runs in CI. -->
        <TargetFrameworks>net472;net10.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <AssemblyName>SodaFlow.Benchmarks</AssemblyName>
        <RootNamespace>SodaFlow.Benchmarks</RootNamespace>
        <EnableDefaultItems>false</EnableDefaultItems>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="BindableRefreshBenchmarks.cs"/>
        <Compile Include="BindableValueBenchmarks.cs"/>
        <Compile Include="KeyedCollectionBuildBenchmarks.cs"/>
        <Compile Include="KeyedCollectionEditBenchmarks.cs"/>
        <Compile Include="KeyedCollectionScaleBenchmarks.cs"/>
        <Compile Include="KeyedCollectionShapes.cs"/>
        <Compile Include="KeyedCollectionViewBenchmarks.cs"/>
        <Compile Include="KeyedCollectionViewShapes.cs"/>
        <Compile Include="Program.cs"/>
        <Compile Include="SelectAllBenchmarks.cs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference
                Include="..\..\Bindable\ObjectModel\CSharp\SodaFlow.Bindable.ObjectModel\SodaFlow.Bindable.ObjectModel.csproj"/>
        <ProjectReference
                Include="..\..\Bindable\ObjectModel\SodaFlow.Core.Bindable.ObjectModel\SodaFlow.Core.Bindable.ObjectModel.csproj"/>
        <ProjectReference Include="..\..\Collections\CSharp\SodaFlow.Collections\SodaFlow.Collections.csproj"/>
        <ProjectReference
                Include="..\..\Collections\SodaFlow.Core.Collections\SodaFlow.Core.Collections.csproj"/>
        <ProjectReference Include="..\..\SodaFlow.Core\SodaFlow.Core.csproj"/>
        <ProjectReference Include="..\SodaFlow.Functional\SodaFlow.Functional.csproj"/>
        <ProjectReference Include="..\SodaFlow\SodaFlow.csproj"/>
    </ItemGroup>

</Project>
