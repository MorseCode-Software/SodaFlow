<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <AssemblyName>SodaFlow.Tests.Memory</AssemblyName>
        <RootNamespace>SodaFlow.Tests.Memory</RootNamespace>
        <EnableDefaultItems>false</EnableDefaultItems>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all"/>
        <PackageReference Include="JetBrains.dotMemoryUnit" Version="3.0.20171219.105559"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1"/>
        <PackageReference Include="NUnit" Version="3.11.0"/>
        <PackageReference Include="NUnit3TestAdapter" Version="3.10.0"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="GarbageCollectionTests.cs"/>
        <Compile Include="StreamTests.cs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\SodaFlow.Core\SodaFlow.Core.csproj"/>
        <ProjectReference Include="..\SodaFlow\SodaFlow.csproj"/>
    </ItemGroup>

</Project>
