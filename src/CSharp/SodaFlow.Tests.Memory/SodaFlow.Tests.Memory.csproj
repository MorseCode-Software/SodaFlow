<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net6.0;net10.0;net472</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <!-- TUnit's transitive dependencies do not claim net472; their netstandard2.0 assets work. -->
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
        <!-- The usings are listed per file here, as everywhere else in this repository. -->
        <TUnitImplicitUsings>disable</TUnitImplicitUsings>
        <TUnitAssertionsImplicitUsings>disable</TUnitAssertionsImplicitUsings>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!--
        net6.0 runs the net6.0 build of the libraries, which an app on .NET 6 or .NET 7 takes. net10.0
        runs the net8.0 build. The SDK reports net6.0 as out of support for an executable, and the
        warning is an error here. The test project exists to run that build, thus the check is off for
        this target only.
    -->
    <PropertyGroup Condition=" '$(TargetFramework)' == 'net6.0' ">
        <CheckEolTargetFramework>false</CheckEolTargetFramework>
    </PropertyGroup>

    <!-- Microsoft.Testing.Platform builds a native apphost for net472, which needs an explicit RID. -->
    <PropertyGroup Condition=" '$(TargetFramework)' == 'net472' ">
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    </PropertyGroup>

    <PropertyGroup>
        <AssemblyName>SodaFlow.Tests.Memory</AssemblyName>
        <RootNamespace>SodaFlow.Tests.Memory</RootNamespace>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.dotMemoryUnit" Version="3.2.20220510"/>
        <PackageReference Include="TUnit" Version="1.66.27"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\TestPolyfills.cs" Link="TestPolyfills.cs"/>
        <Compile Include="..\..\TestParallelism.cs" Link="TestParallelism.cs"/>
        <Compile Include="..\..\TestUnobservedTaskExceptions.cs" Link="TestUnobservedTaskExceptions.cs"/>
        <Compile Include="GarbageCollectionTests.cs"/>
        <Compile Include="StreamTests.cs"/>
        <Compile Include="TimerGarbageCollectionTests.cs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\SodaFlow.Core\SodaFlow.Core.csproj"/>
        <ProjectReference Include="..\SodaFlow\SodaFlow.csproj"/>
    </ItemGroup>

</Project>
