<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Sodium.FSharp.Frp</AssemblyName>
    <RootNamespace>Sodium.Frp</RootNamespace>
    <TargetFrameworks>net472;net60;netstandard2.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SodiumFRP.FSharp</PackageId>
    <MinVerTagPrefix>dotnet-fsharp-</MinVerTagPrefix>
    <Product>Sodium FRP for F#</Product>
    <Title>Sodium FRP for F#</Title>
    <Description>Sodium - Functional Reactive Programming (FRP) library for F#.</Description>
    <!--
        GenerateDocumentationFile rather than a per-configuration DocumentationFile path: this project
        multi-targets, and a single hard-coded path made all three target frameworks write over one
        another's XML. This emits one file per target framework, next to its own assembly, which is
        where NuGet pack expects it when populating each lib folder, and where the DocFX site under
        docs/ picks it up when generating API reference.

        The flag is on, but this assembly currently carries no /// comments, so the XML it emits is
        empty. The DocFX site therefore generates API reference for the C# packages only - see
        docs/docs/fsharp-api.md for why, and what it would take to change that.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="4.5.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Utils.fs" />
    <Compile Include="Transaction.fs" />
    <Compile Include="Listener.fs" />
    <Compile Include="StreamSink.fs" />
    <Compile Include="Cleanup.fs" />
    <Compile Include="BehaviorSink.fs" />
    <Compile Include="CellStreamSink.fs" />
    <Compile Include="CellSink.fs" />
    <Compile Include="Behavior.fs" />
    <Compile Include="Cell.fs" />
    <Compile Include="Stream.fs" />
    <Compile Include="Operational.fs" />
    <Compile Include="Time.fs" />
    <Compile Include="Sodium.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Sodium.Core.Frp\Sodium.Core.Frp.csproj" />
  </ItemGroup>

</Project>
