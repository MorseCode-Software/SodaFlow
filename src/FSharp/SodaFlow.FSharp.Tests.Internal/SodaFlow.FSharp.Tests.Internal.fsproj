<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>SodaFlow.FSharp.Tests.Internal</AssemblyName>
        <RootNamespace>SodaFlow.Tests.Internal</RootNamespace>
        <TargetFramework>net472</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="TestUtils.fs"/>
        <Compile Include="CellTests.fs"/>
        <Compile Include="NodeTests.fs"/>
        <Compile Include="TransactionTests.fs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1"/>
        <PackageReference Include="NUnit" Version="3.11.0"/>
        <PackageReference Include="NUnit3TestAdapter" Version="3.10.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SodaFlow.FSharp\SodaFlow.FSharp.fsproj"/>
    </ItemGroup>

</Project>
