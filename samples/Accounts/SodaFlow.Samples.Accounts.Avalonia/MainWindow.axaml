<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:SodaFlow.Samples.Accounts.ViewModels;assembly=SodaFlow.Samples.Accounts.ViewModels"
        x:Class="SodaFlow.Samples.Accounts.Avalonia.MainWindow"
        Title="SodaFlow Accounts (Avalonia)"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        x:DataType="viewModels:IAccountsViewModel">

    <!--
        Every path ends in .Value, because a bindable property is an object that raises
        PropertyChanged for "Value".

        The rows are the point. Rows.Value moves only when the page's membership or order moves,
        and each row's own bindings follow its own account - so paying into one account updates one
        Balance and leaves the rest of this list untouched.

        The headers are three buttons and one sort stage, not three chains to choose between: the
        stage holds its order in a cell, so a click re-files the keys it already has.
    -->
    <StackPanel Margin="16" Spacing="12">

        <TextBlock Text="{Binding FilterDescription.Value}"
                   FontWeight="SemiBold"/>

        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8">
            <StackPanel Spacing="6">

                <!-- Each caption carries its own marker, so which column is in force and which
                     way it runs are one piece of view model state rather than three. -->
                <Grid ColumnDefinitions="70,*,90,100">
                    <Button Grid.Column="0"
                            Content="{Binding NumberHeader.Value}"
                            Command="{Binding SortByNumber}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="0,2"/>
                    <Button Grid.Column="1"
                            Content="{Binding HolderHeader.Value}"
                            Command="{Binding SortByHolder}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="0,2"/>
                    <Button Grid.Column="2"
                            Content="{Binding BalanceHeader.Value}"
                            Command="{Binding SortByBalance}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Right"
                            Padding="0,2"/>
                </Grid>

                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="0,0,0,1"/>

                <!-- A frozen row greys out and says so where its button would be. That is only
                     what the row looks like: the view model gates the deposit itself, so the
                     button being absent is not what stops a frozen account being paid into. -->
                <ItemsControl ItemsSource="{Binding Rows.Value}">
                    <ItemsControl.Styles>
                        <Style Selector="Grid.frozen > TextBlock">
                            <Setter Property="Foreground" Value="Gray"/>
                            <Setter Property="FontStyle" Value="Italic"/>
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:IAccountRowViewModel">
                            <Grid ColumnDefinitions="70,*,90,100"
                                  Margin="0,2"
                                  Classes.frozen="{Binding IsFrozen.Value}">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Number.Value}"
                                           Opacity="0.6"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Holder.Value}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Balance.Value}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas,Menlo,monospace"/>
                                <Button Grid.Column="3"
                                        Content="Pay $100"
                                        Command="{Binding Deposit}"
                                        IsVisible="{Binding !IsFrozen.Value}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Padding="6,2"
                                        Margin="12,0,0,0"/>
                                <TextBlock Grid.Column="3"
                                           Text="Frozen"
                                           IsVisible="{Binding IsFrozen.Value}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </Border>

        <TextBlock Text="{Binding Total.Value}"/>

        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
            <Button Grid.Column="0"
                    Content="Previous"
                    Command="{Binding PreviousPage}"/>
            <Button Grid.Column="1"
                    Content="Next"
                    Command="{Binding NextPage}"/>
            <TextBlock Grid.Column="2"
                       Text="{Binding Page.Value}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>

        <Button Content="Show or hide frozen"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Command="{Binding ToggleFrozen}"/>

    </StackPanel>

</Window>
