<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!--
            net10.0, not a platform target, and deliberately so: this project is the whole
            sample. If it ever needed a UI framework to compile, the point the sample is making would
            already be lost.
        -->
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <EnableDefaultItems>false</EnableDefaultItems>
        <LangVersion>14</LangVersion>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!--
            Published packages rather than project references into src/. The samples then track
            released versions, so work in progress on the libraries cannot break them: they move when
            someone deliberately bumps a version here, which is also what a reader is going to write in
            their own application.

            This sample referenced the projects until now, and the reason is worth keeping a note of
            because it is spent rather than forgotten: the collections packages were unpublished, and
            this sample existed to find out whether their API needed changing before they shipped.
            Referencing the projects is what let a change to the library and a change to the sample
            happen in one commit. SodaFlow.Collections 1.0.0 is released, so that is over, and this
            sample now keeps the invariant the other three always had.

            SodaFlow.Collections.Core arrives through SodaFlow.Collections and is not named here, as
            the other samples do not name the core packages under their wrappers either. It is what
            pins SodaFlow.Core to 4.0.1 or later, which the collections assemblies need: they reach
            its internals through InternalsVisibleTo, and 4.0.0 would throw MethodAccessException.
            The floor is in that package's dependency range rather than anything written here.
        -->
        <PackageReference Include="SodaFlow" Version="4.0.0"/>
        <PackageReference Include="SodaFlow.Collections" Version="1.0.0"/>
        <PackageReference Include="SodaFlow.Bindable.ObjectModel" Version="3.0.1"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Accounts.cs"/>
        <Compile Include="AccountsViewModelOptimizedDrain.cs" />
        <Compile Include="IAccountsViewModel.cs"/>
        <Compile Include="AccountsViewModel.cs"/>
    </ItemGroup>

</Project>
