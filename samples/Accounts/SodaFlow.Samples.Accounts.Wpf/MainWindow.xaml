<Window x:Class="SodaFlow.Samples.Accounts.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:SodaFlow.Samples.Accounts.ViewModels;assembly=SodaFlow.Samples.Accounts.ViewModels"
        x:ClassModifier="internal"
        Title="SodaFlow Accounts (WPF)"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=viewModels:IAccountsViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <!--
        The same bindings as the Avalonia window, against the same view model. Every path ends in
        .Value, because a bindable property is an object that raises PropertyChanged for "Value".

        The rows are the point. Rows.Value moves only when the page's membership or order moves,
        and each row's own bindings follow its own account - so paying into one account updates one
        Balance and leaves the rest of this list untouched.

        The headers are three buttons and one sort stage, not three chains to choose between: the
        stage holds its order in a cell, so a click re-files the keys it already has.
    -->
    <StackPanel Margin="16">
        <StackPanel.Resources>
            <Style TargetType="Button">
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>

            <!-- WPF has no toggle switch, so this is a CheckBox drawn as one. It is still a
                 CheckBox underneath - the same keyboard handling, focus visual and automation
                 toggle pattern - and IsChecked is what binds. -->
            <Style x:Key="ToggleSwitch" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Track"
                                        Width="40"
                                        Height="20"
                                        CornerRadius="10"
                                        Background="#FFB0B0B0"
                                        VerticalAlignment="Center">
                                    <Ellipse x:Name="Thumb"
                                             Width="14"
                                             Height="14"
                                             Margin="3,0"
                                             Fill="White"
                                             HorizontalAlignment="Left"/>
                                </Border>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track"
                                            Property="Background"
                                            Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </StackPanel.Resources>

        <TextBlock Text="{Binding FilterDescription.Value}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <Border BorderBrush="Gainsboro"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8"
                Margin="0,0,0,12">
            <StackPanel>

                <!-- Each caption carries its own marker, so which column is in force and which
                     way it runs are one piece of view model state rather than three. -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="{Binding NumberHeader.Value}"
                            Command="{Binding SortByNumber}"
                            HorizontalContentAlignment="Left"
                            Padding="0,2"
                            Margin="0"/>
                    <Button Grid.Column="1"
                            Content="{Binding HolderHeader.Value}"
                            Command="{Binding SortByHolder}"
                            HorizontalContentAlignment="Left"
                            Padding="0,2"
                            Margin="0"/>
                    <Button Grid.Column="2"
                            Content="{Binding BalanceHeader.Value}"
                            Command="{Binding SortByBalance}"
                            HorizontalContentAlignment="Right"
                            Padding="0,2"
                            Margin="0"/>
                </Grid>

                <Border BorderBrush="Gainsboro"
                        BorderThickness="0,0,0,1"
                        Margin="0,0,0,6"/>

                <!-- A frozen row greys out and says so where its button would be. That is only
                     what the row looks like: the view model gates the deposit itself, so the
                     button being absent is not what stops a frozen account being paid into. -->
                <ItemsControl ItemsSource="{Binding Rows.Value}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:IAccountRowViewModel}">
                            <Grid x:Name="Row" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Number.Value}"
                                           Foreground="Gray"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Holder.Value}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Balance.Value}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"/>
                                <Button x:Name="Deposit"
                                        Grid.Column="3"
                                        Content="Pay $100"
                                        Command="{Binding Deposit}"
                                        Padding="6,1"
                                        Margin="12,0,0,0"/>
                                <TextBlock x:Name="Frozen"
                                           Grid.Column="3"
                                           Text="Frozen"
                                           Visibility="Collapsed"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFrozen.Value}" Value="True">
                                    <Setter TargetName="Row" Property="TextElement.Foreground" Value="Gray"/>
                                    <Setter TargetName="Row" Property="TextElement.FontStyle" Value="Italic"/>
                                    <Setter TargetName="Deposit" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="Frozen" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </Border>

        <TextBlock Text="{Binding Total.Value}"
                   Margin="0,0,0,12"/>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Previous" Command="{Binding PreviousPage}"/>
            <Button Grid.Column="1" Content="Next" Command="{Binding NextPage}"/>
            <TextBlock Grid.Column="2"
                       Text="{Binding Page.Value}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- The drain empties every frozen account whether or not they are showing, and is
             disabled once none has anything left. -->
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0"
                      Style="{StaticResource ToggleSwitch}"
                      Content="Show frozen accounts"
                      IsChecked="{Binding ShowFrozen.Value, Mode=TwoWay}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Content="Drain frozen accounts"
                    Command="{Binding DrainFrozenAccounts}"
                    Margin="0"/>
        </Grid>

    </StackPanel>

</Window>
