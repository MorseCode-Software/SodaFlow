<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!--
            netstandard2.0, not a platform target, and deliberately so: this project is the whole
            sample. If it ever needed a UI framework to compile, the point the sample is making would
            already be lost.
        -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <EnableDefaultItems>false</EnableDefaultItems>
        <LangVersion>10</LangVersion>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!--
            Published packages rather than project references into src/. The samples then track
            released versions, so work in progress on the libraries cannot break them: they move when
            someone deliberately bumps a version here, which is also what a reader is going to write in
            their own application.
    
            SodaFlow arrives through SodaFlow.Bindable.ObjectModel anyway; it is named here because a
            sample should show what it depends on rather than rely on a transitive.
        -->
        <PackageReference Include="SodaFlow" Version="3.0.0"/>
        <PackageReference Include="SodaFlow.Bindable.ObjectModel" Version="2.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="CounterViewModel.cs"/>
    </ItemGroup>
    
</Project>
