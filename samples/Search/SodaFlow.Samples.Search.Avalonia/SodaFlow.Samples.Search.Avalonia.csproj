<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <IsPackable>false</IsPackable>
        <EnableDefaultItems>false</EnableDefaultItems>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaXaml Include="App.axaml">
            <SubType>Designer</SubType>
        </AvaloniaXaml>
        <Compile Include="App.axaml.cs">
            <DependentUpon>App.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <None Include="app.manifest"/>
        <AvaloniaXaml Include="MainWindow.axaml">
            <SubType>Designer</SubType>
        </AvaloniaXaml>
        <Compile Include="MainWindow.axaml.cs">
            <DependentUpon>MainWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Include="Program.cs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.2"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.2"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The same view model project the WPF head uses, unchanged. -->
        <ProjectReference Include="..\SodaFlow.Samples.Search.ViewModels\SodaFlow.Samples.Search.ViewModels.csproj"/>
    </ItemGroup>

</Project>
