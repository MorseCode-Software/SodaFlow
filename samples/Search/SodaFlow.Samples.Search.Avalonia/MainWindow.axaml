<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:SodaFlow.Samples.Search.ViewModels;assembly=SodaFlow.Samples.Search.ViewModels"
        x:Class="SodaFlow.Samples.Search.Avalonia.MainWindow"
        Title="SodaFlow Search (Avalonia)"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        x:DataType="viewModels:ISearchViewModel">

    <DockPanel Margin="16">

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Search a city. Type &quot;fail&quot; to see the error path."
                       Foreground="Gray"
                       Margin="0,0,0,6" />

            <!--
                Avalonia writes the source on every keystroke by default, so unlike the WPF window
                this needs no UpdateSourceTrigger. Same binding otherwise, same view model.
            -->
            <TextBox Text="{Binding Query.Value}"
                     FontSize="16"
                     Padding="6" />

            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right"
                        Content="Cancel"
                        Command="{Binding Cancel}"
                        Width="80" />
                <!--
                    The same IsBusy the WPF window binds, and the same reason: whether a search is
                    in flight is the view model's answer, not something this window works out.

                    IsVisible takes the bool directly, and the rotation is a style animation rather
                    than a storyboard - the one place the two heads genuinely differ here.
                -->
                <Ellipse DockPanel.Dock="Left"
                         Width="14"
                         Height="14"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Stroke="Gray"
                         StrokeThickness="2"
                         StrokeDashArray="3,2"
                         RenderTransformOrigin="50%,50%"
                         IsVisible="{Binding IsBusy.Value}">
                    <!--
                        The angle is animated rather than the transform itself: Avalonia has an
                        animator for RotateTransform.Angle and none for RenderTransform, and
                        setting the latter throws at runtime rather than at build time.
                    -->
                    <Ellipse.RenderTransform>
                        <RotateTransform />
                    </Ellipse.RenderTransform>
                    <Ellipse.Styles>
                        <Style Selector="Ellipse">
                            <Style.Animations>
                                <Animation Duration="0:0:1" IterationCount="Infinite">
                                    <KeyFrame Cue="0%">
                                        <Setter Property="RotateTransform.Angle" Value="0.0" />
                                    </KeyFrame>
                                    <KeyFrame Cue="100%">
                                        <Setter Property="RotateTransform.Angle" Value="360.0" />
                                    </KeyFrame>
                                </Animation>
                            </Style.Animations>
                        </Style>
                    </Ellipse.Styles>
                </Ellipse>

                <TextBlock Text="{Binding Summary.Value}"
                           VerticalAlignment="Center"
                           Foreground="Gray" />
            </DockPanel>

            <!-- IsVisible takes the bool directly; no converter needed. -->
            <Border Background="#FFF4E5"
                    BorderBrush="#E0A96D"
                    BorderThickness="1"
                    Padding="8"
                    Margin="0,8,0,0"
                    IsVisible="{Binding HasError.Value}">
                <TextBlock Text="{Binding Error.Value}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <ListBox ItemsSource="{Binding Results.Value}"
                 Margin="0,12,0,0" />

    </DockPanel>
</Window>
