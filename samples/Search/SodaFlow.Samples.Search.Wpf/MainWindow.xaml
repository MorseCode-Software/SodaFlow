<Window x:Class="SodaFlow.Samples.Search.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:SodaFlow.Samples.Search.ViewModels;assembly=SodaFlow.Samples.Search.ViewModels"
        mc:Ignorable="d"
        Title="SodaFlow Search (WPF)"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance viewModels:ISearchViewModel}"
        x:ClassModifier="internal">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <DockPanel Margin="16">

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Search a city. Type &quot;fail&quot; to see the error path."
                       Foreground="Gray"
                       Margin="0,0,0,6" />

            <!--
                UpdateSourceTrigger=PropertyChanged is what makes this search-as-you-type. Without
                it WPF writes the source only when the box loses focus, and the graph would never
                see a keystroke.
            -->
            <TextBox Text="{Binding Query.Value, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="16"
                     Padding="6" />

            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right"
                        Content="Cancel"
                        Command="{Binding Cancel}"
                        Width="80"
                        Height="26" />
                <!--
                    Bound to IsBusy, which is the view model's answer to "is a search in flight"
                    rather than anything this window works out for itself. The summary beside it
                    reads "Searching..." from the same cell, so the two cannot disagree.

                    The dashes are what make the rotation visible; a plain circle would turn
                    without appearing to. The animation runs whenever the element is loaded and
                    the element is collapsed when idle, so nothing spins unseen for long.
                -->
                <Ellipse DockPanel.Dock="Left"
                         Width="14"
                         Height="14"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Stroke="Gray"
                         StrokeThickness="2"
                         StrokeDashArray="3,2"
                         RenderTransformOrigin="0.5,0.5"
                         Visibility="{Binding IsBusy.Value, Converter={StaticResource BoolToVisibility}}">
                    <Ellipse.RenderTransform>
                        <RotateTransform />
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                        To="360"
                                        Duration="0:0:1"
                                        RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <TextBlock Text="{Binding Summary.Value}"
                           VerticalAlignment="Center"
                           Foreground="Gray" />
            </DockPanel>

            <Border Background="#FFF4E5"
                    BorderBrush="#E0A96D"
                    BorderThickness="1"
                    Padding="8"
                    Margin="0,8,0,0"
                    Visibility="{Binding HasError.Value, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Error.Value}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <ListBox ItemsSource="{Binding Results.Value}"
                 Margin="0,12,0,0" />

    </DockPanel>
</Window>
