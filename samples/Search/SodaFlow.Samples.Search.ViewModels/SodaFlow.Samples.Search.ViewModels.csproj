<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!--
            net10.0, not a platform target. The whole sample is in this project; if it ever
            needed a UI framework to compile, the point it is making would already be lost.
        -->
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <IsPackable>false</IsPackable>
        <EnableDefaultItems>false</EnableDefaultItems>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="ISearchViewModel.cs"/>
        <Compile Include="SearchViewModel.cs"/>
        <Compile Include="Catalog.cs"/>
    </ItemGroup>

    <ItemGroup>
        <!--
            Published packages rather than project references into src/. The samples then track
            released versions, so work in progress on the libraries cannot break them: they move when
            someone deliberately bumps a version here, which is also what a reader is going to write in
            their own application.
        -->
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all"/>
        <PackageReference Include="SodaFlow" Version="4.0.0"/>
        <PackageReference Include="SodaFlow.Async" Version="4.0.0"/>
        <PackageReference Include="SodaFlow.Bindable.ObjectModel" Version="3.0.1"/>
    </ItemGroup>

</Project>
