<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!--
            netstandard2.0, not a platform target. The whole sample is in this project; if it ever
            needed a UI framework to compile, the point it is making would already be lost.
        -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>10</LangVersion>
        <IsPackable>false</IsPackable>
        <EnableDefaultItems>false</EnableDefaultItems>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="IBounceViewModel.cs"/>
        <Compile Include="BounceViewModel.cs"/>
        <Compile Include="IScene.cs"/>
        <Compile Include="SceneExtensionMethods.cs"/>
        <Compile Include="SimpleScene.cs"/>
        <Compile Include="WallsScene.cs"/>
        <Compile Include="GrabScene.cs"/>
        <Compile Include="Arrangement.cs"/>
        <Compile Include="Ball.cs"/>
        <Compile Include="BouncingAxis.cs"/>
        <Compile Include="Flight.cs"/>
        <Compile Include="PointerTrail.cs"/>
    </ItemGroup>

    <ItemGroup>
        <!--
            Published packages rather than project references into src/. The samples then track
            released versions, so work in progress on the libraries cannot break them: they move when
            someone deliberately bumps a version here, which is also what a reader is going to write in
            their own application.
        -->
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all"/>
        <PackageReference Include="SodaFlow" Version="4.0.0"/>
        <PackageReference Include="SodaFlow.Bindable.ObjectModel" Version="3.0.0"/>
    </ItemGroup>

</Project>
