<Window x:Class="SodaFlow.Samples.Bounce.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:SodaFlow.Samples.Bounce.ViewModels;assembly=SodaFlow.Samples.Bounce.ViewModels"
        xmlns:local="clr-namespace:SodaFlow.Samples.Bounce.Wpf"
        mc:Ignorable="d"
        Title="SodaFlow Bounce (WPF)"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance viewModels:IBounceViewModel}"
        x:ClassModifier="internal">

    <Window.Resources>
        <!-- WPF has no IsVisible, so the same bool reaches Visibility through the converter the
             framework ships for exactly this. -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </Window.Resources>

    <!--
        A tab per scene, smallest first. The selection is bound rather than left to the control,
        so which scene is showing is a value in the view model: the summary above is a function of
        it, and the view model can set it to change the tab. It also settles what opens, which the
        two frameworks did not agree on by default - Avalonia selected the first tab on its own and
        WPF opened with none selected.

        Each tab hands its scene to a SceneView, which draws it by sampling. Nothing about the balls
        binds, because a behavior has no changes to be notified of.
    -->
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding SelectedSummary.Value}"
                   TextWrapping="Wrap"
                   Foreground="Gray"
                   Margin="0,0,0,12" />

        <!--
            Shown only for the scenes the damping applies to, which is a value on the view model
            rather than anything this markup works out. The slider writes a multiplier the bounce
            reads when it happens, so moving it changes the next bounce and not the flight already
            under way.
        -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    Margin="0,12,0,0"
                    Visibility="{Binding IsDampingAvailable.Value, Converter={StaticResource BooleanToVisibility}}">
            <CheckBox Content="Damping"
                      IsChecked="{Binding DampingEnabled.Value, Mode=TwoWay}"
                      VerticalAlignment="Center" />

            <Slider Minimum="{Binding MinimumDamping}"
                    Maximum="{Binding MaximumDamping}"
                    Value="{Binding Damping.Value, Mode=TwoWay}"
                    IsEnabled="{Binding DampingEnabled.Value}"
                    Width="200"
                    Margin="12,0,8,0"
                    VerticalAlignment="Center" />

            <TextBlock Text="{Binding Damping.Value, StringFormat={}{0:F2}}"
                       Foreground="Gray"
                       VerticalAlignment="Center" />
        </StackPanel>

        <TabControl ItemsSource="{Binding Scenes}"
                    SelectedItem="{Binding SelectedScene.Value, Mode=TwoWay}">
            <TabControl.ItemTemplate>
                <DataTemplate DataType="{x:Type viewModels:IScene}">
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate DataType="{x:Type viewModels:IScene}">
                    <local:SceneView Scene="{Binding}"
                                     HorizontalAlignment="Left"
                                     Margin="4" />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>
</Window>
