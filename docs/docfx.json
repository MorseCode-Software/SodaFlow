{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",

  "metadata": [
    {
      "//": [
        "Only the C# packages are listed. SodaFlow.FSharp and SodaFlow.FSharp.Async are",
        "deliberately absent: DocFX reads compiled metadata, so an F# assembly renders in its",
        "compiled shape (modules as static classes, FSharpFunc in every signature), and those",
        "assemblies carry no /// comments to render anyway. See docs/fsharp-api.md.",
        "",
        "TargetFramework is pinned because every project here multi-targets net472, net60 and",
        "netstandard2.0. Without pinning, DocFX builds all three and emits duplicate members.",
        "net60 is the alias these projects use for net6.0; the output folder is literally 'net60'."
      ],
      "src": [
        {
          "src": "../src",
          "files": [
            "SodaFlow.Core/SodaFlow.Core.csproj",
            "CSharp/SodaFlow/SodaFlow.csproj",
            "CSharp/SodaFlow.Functional/SodaFlow.Functional.csproj",
            "Async/SodaFlow.Core.Async/SodaFlow.Core.Async.csproj",
            "Async/CSharp/SodaFlow.Async/SodaFlow.Async.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net60",
        "Configuration": "Release"
      },
      "memberLayout": "separatePages",
      "namespaceLayout": "nested"
    }
  ],

  "build": {
    "content": [
      {
        "files": [ "**/*.{md,yml}" ],
        "exclude": [ "_site/**", "**/bin/**", "**/obj/**", "README.md" ]
      }
    ],
    "resource": [
      {
        "files": [ "images/**" ],
        "exclude": [ "_site/**" ]
      }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "postProcessors": [ "ExtractSearchIndex" ],
    "globalMetadata": {
      "_appName": "SodaFlow",
      "_appTitle": "SodaFlow for .NET",
      "_appFooter": "SodaFlow &mdash; BSD-3-Clause",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/SodaFlow/sodium",
        "branch": "master"
      }
    }
  }
}
